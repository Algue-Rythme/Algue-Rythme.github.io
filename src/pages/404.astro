---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" path="/404">
  <section class="section container">
    <p class="eyebrow">404</p>
    <h1 class="section__title">This page could not be found.</h1>
    <p class="prose">
      The page you are looking for may have moved. Try the
      <a href="/">homepage</a>, or jump to
      <a href="/work">My work</a>, <a href="/publications">Publications</a>,
      <a href="/software">Software</a>, or <a href="/about">About me</a>.
    </p>
  </section>
</Base>
